<% content_for :title, "Оплата замовлення №#{@order.id}" %>

<h1 class="h3 mb-4">Оплата замовлення №<%= @order.id %></h1>

<div class="row">
  <div class="col-lg-6">
    <div class="card card-body shadow-sm">
      <p class="mb-1">До сплати:</p>
      <p class="display-6 fw-bold"><%= money(@order.total_price) %></p>
      <%= button_to "Оплатити (тестовий режим)", order_payment_path(@order), class: "btn btn-success w-100" %>
      <%= link_to "Сплатити пізніше", @order, class: "btn btn-link mt-2" %>
    </div>
  </div>
</div>