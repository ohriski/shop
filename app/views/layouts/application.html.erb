<!DOCTYPE html>
<html lang="uk">
  <head>
    <title><%= content_for(:title) || "Shop" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
  </head>

  <body class="bg-light d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <%= link_to "Shop", root_path, class: "navbar-brand" %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainMenu">
          <ul class="navbar-nav me-auto">
            <li class="nav-item"><%= link_to "Каталог", products_path, class: "nav-link" %></li>
          </ul>

          <div class="d-flex align-items-center gap-2">
            <%= link_to cart_path, class: "btn btn-outline-light btn-sm" do %>
  Кошик <span class="badge text-bg-primary"><%= cart_quantity %></span>
<% end %>
            <% if authenticated? %>
              <span class="navbar-text me-2"><%= Current.user.email_address %></span>
              <%= button_to "Вийти", session_path, method: :delete, class: "btn btn-outline-light btn-sm" %>
            <% else %>
              <%= link_to "Увійти", new_session_path, class: "btn btn-outline-light btn-sm" %>
              <%= link_to "Реєстрація", new_registration_path, class: "btn btn-primary btn-sm" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <main class="container my-4 flex-grow-1">
      <% if notice %>
        <div class="alert alert-success"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="alert alert-danger"><%= alert %></div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="bg-dark text-white-50 py-3 mt-auto">
      <div class="container text-center small">&copy; <%= Time.current.year %> Shop</div>
    </footer>
  </body>
</html>