<% content_for :title, "Редагування профілю" %>

<h1 class="h3 mb-4">Редагування профілю</h1>

<div class="row">
  <div class="col-lg-7">
    <%= form_with model: @user, url: profile_path, method: :patch, class: "card card-body shadow-sm" do |form| %>
      <% if @user.errors.any? %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <%= form.label :name, "Імʼя та прізвище", class: "form-label" %>
        <%= form.text_field :name, class: "form-control" %>
      </div>
      <div class="mb-3">
        <%= form.label :phone, "Телефон", class: "form-label" %>
        <%= form.telephone_field :phone, class: "form-control" %>
      </div>
      <div class="mb-4">
        <%= form.label :email_address, "Email", class: "form-label" %>
        <%= form.email_field :email_address, class: "form-control" %>
      </div>

      <h2 class="h6">Зміна пароля або email</h2>
      <p class="text-muted small">Щоб змінити пароль чи email, введіть поточний пароль. Нові поля пароля можна лишити порожніми.</p>

      <div class="mb-3">
        <%= label_tag "user_current_password", "Поточний пароль", class: "form-label" %>
        <%= password_field_tag "user[current_password]", nil, id: "user_current_password", class: "form-control", autocomplete: "current-password" %>
      </div>
      <div class="mb-3">
        <%= form.label :password, "Новий пароль", class: "form-label" %>
        <%= form.password_field :password, class: "form-control", autocomplete: "new-password" %>
      </div>
      <div class="mb-3">
        <%= form.label :password_confirmation, "Повторіть новий пароль", class: "form-label" %>
        <%= form.password_field :password_confirmation, class: "form-control", autocomplete: "new-password" %>
      </div>

      <div class="d-flex gap-2">
        <%= form.submit "Зберегти", class: "btn btn-primary" %>
        <%= link_to "Скасувати", profile_path, class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
</div>