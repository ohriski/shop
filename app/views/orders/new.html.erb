<% content_for :title, "Оформлення замовлення" %>

<h1 class="h3 mb-4">Оформлення замовлення</h1>

<div class="row g-4">
  <div class="col-lg-7">
    <%= form_with model: @order, class: "card card-body shadow-sm" do |form| %>
      <% if @order.errors.any? %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% @order.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <%= form.label :customer_name, "Імʼя та прізвище", class: "form-label" %>
        <%= form.text_field :customer_name, class: "form-control" %>
      </div>
      <div class="mb-3">
        <%= form.label :phone, "Телефон", class: "form-label" %>
        <%= form.telephone_field :phone, class: "form-control" %>
      </div>

      <h2 class="h6 mt-2">Спосіб доставки</h2>
      <div class="mb-3">
        <% @delivery_methods.each do |dm| %>
          <div class="form-check">
            <%= form.radio_button :delivery_method_id, dm.id,
                  class: "form-check-input",
                  data: { requires_address: dm.requires_address? },
                  onchange: "document.getElementById('address-fields').hidden = this.dataset.requiresAddress !== 'true'" %>
            <%= form.label :delivery_method_id, value: dm.id, class: "form-check-label" do %>
              <%= dm.name %> — <%= dm.price.zero? ? "безкоштовно" : money(dm.price) %>
            <% end %>
          </div>
        <% end %>
      </div>

      <%= tag.div id: "address-fields", hidden: !@order.delivery_method&.requires_address? do %>
        <div class="mb-3">
          <%= form.label :city, "Місто", class: "form-label" %>
          <%= form.text_field :city, class: "form-control" %>
        </div>
        <div class="mb-3">
          <%= form.label :address, "Адреса або номер відділення", class: "form-label" %>
          <%= form.text_field :address, class: "form-control" %>
        </div>
      <% end %>

      <h2 class="h6 mt-2">Спосіб оплати</h2>
      <div class="mb-3">
        <% Order::PAYMENT_METHOD_LABELS.each do |value, label| %>
          <div class="form-check">
            <%= form.radio_button :payment_method, value, class: "form-check-input" %>
            <%= form.label :payment_method, label, value: value, class: "form-check-label" %>
          </div>
        <% end %>
      </div>

      <%= form.submit "Підтвердити замовлення", class: "btn btn-success" %>
    <% end %>
  </div>

  <div class="col-lg-5">
    <div class="card card-body shadow-sm">
      <h2 class="h5">Ваше замовлення</h2>
      <ul class="list-unstyled mb-3">
        <% @items.each do |item| %>
          <li class="d-flex justify-content-between">
            <span><%= item.product.name %> × <%= item.quantity %></span>
            <span><%= money(item.subtotal) %></span>
          </li>
        <% end %>
      </ul>
      <div class="d-flex justify-content-between fw-bold border-top pt-2">
        <span>Товари:</span>
        <span><%= money(@cart.total_price) %></span>
      </div>
    </div>
  </div>
</div>