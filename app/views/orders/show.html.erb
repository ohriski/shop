<% content_for :title, "Замовлення №#{@order.id}" %>

<h1 class="h3 mb-3">Замовлення №<%= @order.id %></h1>

<p class="mb-1"><strong>Статус:</strong> <%= @order.status_label %></p>
<p class="mb-1"><strong>Одержувач:</strong> <%= @order.customer_name %></p>
<p class="mb-4"><strong>Телефон:</strong> <%= @order.phone %></p>

<table class="table align-middle bg-white shadow-sm">
  <thead>
    <tr><th>Товар</th><th>Ціна</th><th>Кількість</th><th>Сума</th></tr>
  </thead>
  <tbody>
    <% @order.order_items.includes(:product).each do |item| %>
      <tr>
        <td><%= item.product.name %></td>
        <td><%= money(item.unit_price) %></td>
        <td><%= item.quantity %></td>
        <td><%= money(item.subtotal) %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr>
      <td colspan="3" class="text-end fw-bold">Разом:</td>
      <td class="fw-bold"><%= money(@order.total_price) %></td>
    </tr>
  </tfoot>
</table>

<%= link_to "До каталогу", products_path, class: "btn btn-outline-secondary" %>