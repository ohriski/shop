<%= form_with(model: product) do |form| %>
  <% if product.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% product.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, "Назва", class: "form-label" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :category_id, "Категорія", class: "form-label" %>
    <%= form.collection_select :category_id, Category.order(:name), :id, :name,
          { prompt: "Оберіть категорію" }, { class: "form-select" } %>
  </div>

  <div class="mb-3">
    <%= form.label :description, "Опис", class: "form-label" %>
    <%= form.text_area :description, rows: 5, class: "form-control" %>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= form.label :price, "Ціна, ₴", class: "form-label" %>
      <%= form.number_field :price, step: 0.01, min: 0.01, class: "form-control" %>
    </div>
    <div class="col-md-6 mb-3">
      <%= form.label :stock, "Кількість на складі", class: "form-label" %>
      <%= form.number_field :stock, min: 0, class: "form-control" %>
    </div>
  </div>

  <div class="mb-3">
    <%= form.label :image, "Фото товару", class: "form-label" %>
    <% if product.image.attached? %>
      <div class="mb-2"><%= image_tag product.image, class: "img-thumbnail", style: "max-height: 120px;" %></div>
    <% end %>
    <%= form.file_field :image, accept: "image/jpeg,image/png,image/webp", class: "form-control" %>
  </div>

  <%= form.submit "Зберегти", class: "btn btn-primary" %>
  <%= link_to "Скасувати", products_path, class: "btn btn-outline-secondary" %>
<% end %>