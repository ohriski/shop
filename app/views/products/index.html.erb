<% content_for :title, "Каталог" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Каталог товарів</h1>
  <% if admin? %>
  <%= link_to "Додати товар", new_product_path, class: "btn btn-success" %>
<% end %>
</div>

<ul class="nav nav-pills mb-4">
  <li class="nav-item">
    <%= link_to "Усі", products_path, class: "nav-link #{'active' if params[:category_id].blank?}" %>
  </li>
  <% @categories.each do |category| %>
    <li class="nav-item">
      <%= link_to category.name, products_path(category_id: category.id),
            class: "nav-link #{'active' if params[:category_id].to_s == category.id.to_s}" %>
    </li>
  <% end %>
</ul>

<% if @products.empty? %>
  <div class="alert alert-info">У цій категорії поки немає товарів.</div>
<% end %>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
  <% @products.each do |product| %>
    <div class="col">
      <div class="card h-100 shadow-sm">
        <% if product.image.attached? %>
          <%= image_tag product.image, class: "card-img-top product-img", alt: product.name %>
        <% else %>
          <div class="product-img d-flex align-items-center justify-content-center text-muted">Немає фото</div>
        <% end %>

        <div class="card-body d-flex flex-column">
          <span class="badge text-bg-secondary align-self-start mb-2"><%= product.category.name %></span>
          <h2 class="h5 card-title"><%= product.name %></h2>
          <p class="card-text text-muted"><%= truncate(product.description, length: 90) %></p>
          <div class="mt-auto">
            <p class="fw-bold fs-5 mb-1"><%= number_to_currency(product.price, unit: "₴", format: "%n %u") %></p>
            <p class="small <%= product.stock.positive? ? 'text-success' : 'text-danger' %>">
              <%= product.stock.positive? ? "В наявності: #{product.stock}" : "Немає в наявності" %>
            </p>
            <%= link_to "Детальніше", product, class: "btn btn-primary btn-sm" %>
            <% if admin? %>
  <%= link_to "Редагувати", edit_product_path(product), class: "btn btn-outline-secondary btn-sm" %>
<% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>